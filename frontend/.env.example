# Copy this file to ".env.local" and fill in your DEV values.
# .env.local is ignored by Git.
#
# IMPORTANT: every VITE_ value is baked into the JavaScript sent to the
# browser, so anyone can read it. That's fine for these (they're public
# identifiers, not secrets) but NEVER put a secret, like an API key, in here.

VITE_API_URL=http://localhost:8000

# From your DEV Cognito user pool (see README, Step 4).
VITE_COGNITO_REGION=eu-west-2
VITE_COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your-app-client-id
VITE_COGNITO_DOMAIN=https://your-prefix.auth.eu-west-2.amazoncognito.com
