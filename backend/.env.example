# Copy this file to ".env" (in this same backend folder) and fill in your values.
# .env is ignored by Git, so your real values are never uploaded.

ENVIRONMENT=dev

# When the backend runs inside Docker Compose, docker-compose.yml overrides
# this with mongodb://mongo:27017 automatically. This value is for running
# the backend directly on your machine (or for pytest).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=mock_interview_dev

# From your DEV Cognito user pool (see README, Step 4).
COGNITO_REGION=eu-north-1
COGNITO_USER_POOL_ID=eu-north-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-app-client-id
COGNITO_DOMAIN=https://your-prefix.auth.eu-north-1.amazoncognito.com

CORS_ORIGINS=http://localhost:5173

# --- Video storage (Phase 2) ---
AWS_REGION=eu-north-1
S3_VIDEOS_BUCKET=your-dev-bucket-name

# Access keys for the "mock-interview-dev-local" IAM user (see PHASE2.md, Step 3).
# These are SECRETS: they stay in this file, which Git ignores.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
