# Copy this file to ".env" (in this same backend folder) and fill in your values.
# .env is ignored by Git, so your real values are never uploaded.

ENVIRONMENT=dev

# When the backend runs inside Docker Compose, docker-compose.yml overrides
# this with mongodb://mongo:27017 automatically. This value is for running
# the backend directly on your machine (or for pytest).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=mock_interview_dev

# From your DEV Cognito user pool (see README, Step 4).
COGNITO_REGION=eu-west-2
COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX
COGNITO_CLIENT_ID=your-app-client-id
COGNITO_DOMAIN=https://your-prefix.auth.eu-west-2.amazoncognito.com

CORS_ORIGINS=http://localhost:5173
